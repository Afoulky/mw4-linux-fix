+/* The small-primitive cull drops face triangles that cover samples, leaving faces see-through.
+ * The prefix sum needs 32 or more lanes per wave: its scratch array holds 8 waves of a 256-thread group.
+ * Without a required size of 32, Intel Arc (16 to 32 lanes) fails to compile it. */
+static const struct vkd3d_shader_quirk_hash cod_mw4_hashes[] = {
+    { "triangle_cull_pass_camera", 0, VKD3D_SHADER_QUIRK_DISABLE_SMALL_PRIMITIVE_CULL },
+    { "triangle_cull_pass_camera_occlusion", 0, VKD3D_SHADER_QUIRK_DISABLE_SMALL_PRIMITIVE_CULL },
+    { "prefix_sum_lookback", 0, VKD3D_SHADER_QUIRK_FORCE_MIN_WAVE32 },
+};
+
+static const struct vkd3d_shader_quirk_info cod_mw4_quirks = {
+    cod_mw4_hashes, ARRAY_SIZE(cod_mw4_hashes), 0,
+};
