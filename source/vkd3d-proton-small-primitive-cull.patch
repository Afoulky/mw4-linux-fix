             goto end;
@@ -1666,6 +1748,15 @@ int vkd3d_shader_compile_dxil(const struct vkd3d_shader_code *dxbc,
         memcpy(code, compiled.data, compiled.size);
         spirv->code = code;
         spirv->size = compiled.size;
+
+        if (quirks & VKD3D_SHADER_QUIRK_DISABLE_SMALL_PRIMITIVE_CULL)
+        {
+            size_t word_count = spirv->size / sizeof(uint32_t);
+            unsigned int patched = vkd3d_dxil_disable_small_primitive_cull(code, &word_count);
