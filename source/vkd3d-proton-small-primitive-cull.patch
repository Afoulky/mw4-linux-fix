+/* Rewrites every OpBranchConditional whose condition is
+ * OpLogicalOr(OpFOrdEqual(RoundEven, RoundEven), OpFOrdEqual(RoundEven, RoundEven)) to branch on false.
+ * The control flow graph is untouched. words must have room for 3 extra words,
+ * in case an OpConstantFalse has to be added. Returns the number of patched branches. */
+static unsigned int vkd3d_dxil_disable_small_primitive_cull(uint32_t *words, size_t *word_count)
+{
+    uint32_t glsl_set = 0, bool_type = 0, false_id = 0, bool_offset = 0;
+    unsigned int patched = 0;
+    size_t offset, count;
+    uint8_t *id_kind;
+    uint32_t bound;
+    SpvOp op;
+
+    enum { ID_ROUND_EVEN = 1, ID_ROUND_EVEN_EQUAL, ID_SMALL_PRIMITIVE_TEST };
+
+    if (*word_count < 5)
+        return 0;
+    bound = words[3];
+    if (!(id_kind = vkd3d_calloc(bound, sizeof(*id_kind))))
+        return 0;
+
+    for (offset = 5; offset < *word_count; offset += count)
+    {
+        op = words[offset] & 0xffff;
+        count = words[offset] >> 16;
+        if (!count || offset + count > *word_count)
+            break;
+
+        if (op == SpvOpExtInstImport && count >= 3 && !strcmp((const char *)&words[offset + 2], "GLSL.std.450"))
+            glsl_set = words[offset + 1];
+        else if (op == SpvOpTypeBool && count == 2)
+        {
+            bool_type = words[offset + 1];
+            bool_offset = offset + count;
+        }
+        else if (op == SpvOpConstantFalse && count == 3 && words[offset + 1] == bool_type)
+            false_id = words[offset + 2];
+        else if (op == SpvOpExtInst && count >= 6 && words[offset + 3] == glsl_set &&
+                words[offset + 4] == GLSLstd450RoundEven && words[offset + 2] < bound)
+            id_kind[words[offset + 2]] = ID_ROUND_EVEN;
+        else if (op == SpvOpFOrdEqual && count == 5 && words[offset + 2] < bound &&
+                words[offset + 3] < bound && words[offset + 4] < bound &&
+                id_kind[words[offset + 3]] == ID_ROUND_EVEN && id_kind[words[offset + 4]] == ID_ROUND_EVEN)
+            id_kind[words[offset + 2]] = ID_ROUND_EVEN_EQUAL;
+        else if (op == SpvOpLogicalOr && count == 5 && words[offset + 2] < bound &&
+                words[offset + 3] < bound && words[offset + 4] < bound &&
+                id_kind[words[offset + 3]] == ID_ROUND_EVEN_EQUAL && id_kind[words[offset + 4]] == ID_ROUND_EVEN_EQUAL)
+            id_kind[words[offset + 2]] = ID_SMALL_PRIMITIVE_TEST;
+        else if (op == SpvOpBranchConditional && count >= 4 && words[offset + 1] < bound &&
+                id_kind[words[offset + 1]] == ID_SMALL_PRIMITIVE_TEST && bool_type)
+        {
+            if (!false_id)
+            {
+                /* Declare OpConstantFalse right after OpTypeBool. Later offsets shift by 3 words. */
+                false_id = bound++;
+                memmove(&words[bool_offset + 3], &words[bool_offset], (*word_count - bool_offset) * sizeof(*words));
+                words[bool_offset] = (3u << 16) | SpvOpConstantFalse;
+                words[bool_offset + 1] = bool_type;
+                words[bool_offset + 2] = false_id;
+                *word_count += 3;
+                words[3] = bound;
+                offset += 3;
+            }
+            words[offset + 1] = false_id;
+            patched++;
+        }
+    }
+
+    vkd3d_free(id_kind);
+    return patched;
+}
